<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if pageTitle %}<title>{{ pageTitle }}</title>{% else %}<title>{{ title }} – JJ's Stuff</title>{% endif %}
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
{% if metaDescription %}<meta name="description" content="{{ metaDescription }}">{% endif %}
{% if ogUrl %}
<meta property="og:title" content="JJ's Stuff – {{ title }}">
<meta property="og:description" content="{{ ogDescription }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ ogUrl }}">
<meta property="og:locale" content="{{ ogLocale }}">
{% endif %}
{% if site.googleSiteVerification %}<meta name="google-site-verification" content="{{ site.googleSiteVerification }}" />{% endif %}
{% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}
<link rel="icon" href="{{ rootPath }}favicon.svg" type="image/svg+xml">
{% if hreflang %}
<link rel="alternate" hreflang="en" href="https://jjsstuff.github.io/en/">
<link rel="alternate" hreflang="de" href="https://jjsstuff.github.io/">
<link rel="alternate" hreflang="x-default" href="https://jjsstuff.github.io/">
{% endif %}
<link rel="preload" href="{{ rootPath }}assets/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ rootPath }}assets/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ rootPath }}css/style.css">
