---
layout: base.njk
noindex: true
pagination:
  data: apps
  size: 1
  alias: app
permalink: "en/apps/{{ app.slug }}/privacy.html"
eleventyComputed:
  title: "Privacy Policy – {{ app.name.en }}"
  lang: "en"
  homeUrl: "/en/"
  rootPath: "../../../"
  heading: "Privacy Policy – {{ app.name.en }}"
  langSwitchHref: "/apps/{{ app.slug }}/datenschutz.html"
  langSwitchTitle: "Deutsch"
  langSwitchLabel: "DE"
  footerLinks: '<a href="/en/">← Back to Homepage</a><span class="footer__sep">·</span><a href="../../../impressum.html">Legal Notice (German)</a><span class="footer__sep">·</span><a href="../../privacy.html">General Privacy Policy</a><span class="footer__sep">·</span><a href="https://play.google.com/store/apps/details?id={{ app.playStoreId }}" target="_blank" rel="noopener">{{ app.name.en | replace(" App", "") }} (Play Store)</a>'
---
<main class="section legal">
    <div class="section__container">
        <h1 class="section__title">{{ heading }}</h1>
        <div class="legal__content">
            {%- if app.type == "connected" -%}
            {% include "app-privacy-connected.njk" %}
            {%- else -%}
            {% include "app-privacy-offline.njk" %}
            {%- endif -%}
        </div>
    </div>
</main>
